          "assert": {
            "initiatorState": "unbound",
            "responderState": "recovering",
            "currentBinding": { "initiator": null, "responder": null },
            "dispatchCount": 0,
            "callerOutcome": { "callId": null, "status": "none" },
            "retainedEvidence": { "initiator": [], "responder": ["session:session-1", "proof-key", "binding-epoch:1", "recovery-deadline"] },
