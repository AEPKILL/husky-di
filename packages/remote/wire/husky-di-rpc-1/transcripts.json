{
  "profile": "husky-di-rpc/1",
  "format": "Normative state-machine fixtures. Actions describe injected Transport or timer events; every assertion is the complete observation after that action.",
  "scenarios": [
    {
      "id": "fresh-establishment",
      "covers": ["fresh", "RPC-WIRE-007", "RPC-WIRE-008", "RPC-WIRE-009"],
      "steps": [
        {
          "id": "fresh-request-admitted",
          "action": { "type": "deliver", "connection": "c1", "from": "initiator", "record": "fresh-request" },
          "assert": {
            "initiatorState": "connecting",
            "responderState": "bootstrapping",
            "currentBinding": { "initiator": null, "responder": null },
            "dispatchCount": 0,
            "callerOutcome": { "callId": null, "status": "none" },
            "retainedEvidence": { "initiator": ["fresh-request:c1"], "responder": ["provisional-session-id", "handshake-permit:c1"] },
            "nextPermittedRecords": { "initiator": [], "responder": ["accept", "reject"] }
          }
        },
        {
          "id": "fresh-accept-verified",
          "action": { "type": "deliver", "connection": "c1", "from": "responder", "record": "fresh-accept" },
          "assert": {
            "initiatorState": "connected",
            "responderState": "connected",
            "currentBinding": { "initiator": "c1@1", "responder": "c1@1" },
            "dispatchCount": 0,
            "callerOutcome": { "callId": null, "status": "none" },
            "retainedEvidence": { "initiator": ["session:session-1", "proof-key", "binding-epoch:1"], "responder": ["session:session-1", "proof-key", "binding-epoch:1"] },
            "nextPermittedRecords": { "initiator": ["message", "ack", "ping", "pong", "close"], "responder": ["message", "ack", "ping", "pong", "close"] }
          }
        }
      ]
    },
    {
      "id": "lost-fresh-accept",
