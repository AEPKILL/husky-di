{
	"name": "@husky-di/remote",
	"version": "0.0.0",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=23.6"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"LICENSE"
	],
	"scripts": {
		"build": "rslib build",
		"dev": "rslib build --watch",
		"test": "pnpm run typecheck && pnpm run test:types && vitest run && pnpm run test:browser",
		"test:browser": "playwright test --config playwright.config.ts --pass-with-no-tests",
		"test:types": "vitest run --typecheck --typecheck.only",
		"typecheck": "tsc -p tsconfig.json && tsc -p tests/tsconfig.json"
	},
	"dependencies": {
		"@husky-di/core": "workspace:*",
		"rxjs": "^7.8.2",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@husky-di/config": "workspace:*",
		"@playwright/test": "1.62.1",
		"@rslib/core": "^0.20.1",
		"@types/node": "^25.5.0",
		"esbuild": "0.27.4",
		"typescript": "^6.0.3",
		"vitest": "^4.1.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
