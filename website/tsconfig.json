{
	"extends": "@husky-di/config/tsconfig/base.json",
	"include": ["**/*.ts", "**/*.tsx", "**/*.d.ts", "**/*.mdx"],
	"compilerOptions": {
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"target": "ESNext",
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	}
}
