{
	"compilerOptions": {
		"lib": ["ES2024"],
		"module": "ESNext",
		"target": "ES2024",
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"moduleResolution": "bundler",
		"rootDir": "./src",
		"types": ["node"],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src"]
}
